# Copy to .env.local. Email login works without any of these.

# Optional public origin when OAuth redirect URIs must match a fixed host.
# APP_URL=http://127.0.0.1:43123

# Google OAuth. Redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X (Twitter) OAuth 2.0. Redirect URI: {APP_URL}/api/auth/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
